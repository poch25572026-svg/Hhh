local function createButtonToggle(name, callback)
    local btn = Instance.new("TextButton")
    btn.Size = UDim2.new(1, -10, 0, 40)
    btn.BackgroundColor3 = Color3.fromRGB(30, 30, 30)
    btn.TextColor3 = Color3.fromRGB(255, 255, 255)
    btn.TextSize = 13
    btn.Font = Enum.Font.Gotham
    btn.Text = name .. " [ ปิด ]"
    btn.Parent = ScrollingFrame

    local corner = Instance.new("UICorner")
    corner.CornerRadius = UDim.new(0, 6)
    corner.Parent = btn

    local active = false
    btn.MouseButton1Click:Connect(function()
        active = not active
        if active then
            btn.BackgroundColor3 = Color3.fromRGB(0, 170, 127)
            btn.Text = name .. " [ เปิด ]"
        else
            btn.BackgroundColor3 = Color3.fromRGB(30, 30, 30)
            btn.Text = name .. " [ ปิด ]"
        end
        callback(active)
    end)
end

-- ==================== ฟังก์ชันสปอนรีโมทแยกตามบล็อก ====================

local function setupSpawner(buttonName, keyword)
    createButtonToggle(buttonName, function(state)
        task.spawn(function()
            local targetRemote
            while state do
                if not targetRemote then
                    for _, v in ipairs(ReplicatedStorage:GetDescendants()) do
                        if v:IsA("RemoteEvent") and v.Name:lower():find(keyword) then
                            targetRemote = v
                            break
                        end
                    end
                end
                
                if targetRemote then
                    pcall(function()
                        targetRemote:FireServer()
                    end)
                end
                task.wait(0.1)
            end
        end)
    end)
end

