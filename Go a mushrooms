MyWindow:AddButton("ขายไอเทม/ผลผลิตทั้งหมดในกระเป๋า (Sell All Items)", function()
    pcall(function()
        if ReplicatedStorage:FindFirstChild("SellAllRequest") then
            ReplicatedStorage.SellAllRequest:FireServer()
        elseif ReplicatedStorage:FindFirstChild("SellRequest") then
            ReplicatedStorage.SellRequest:FireServer()
