AddSection("3. ระบบวาร์ป & ฟาร์มเหรียญ")
AddButton("วาร์ปไปหาฆาตกรด่วน", function()
    pcall(function()
        local hrp = LocalPlayer.Character and LocalPlayer.Character:FindFirstChild("HumanoidRootPart")
        if hrp then
            for _, p in ipairs(Players:GetPlayers()) do
                if p ~= LocalPlayer and p.Character then
                    local bp = p:FindFirstChild("Backpack")
                    local hasKnife = (bp and bp:FindFirstChild("Knife")) or p.Character:FindFirstChild("Knife")
                    if hasKnife and p.Character:FindFirstChild("HumanoidRootPart") then
                        hrp.CFrame = p.Character.HumanoidRootPart.CFrame + Vector3.new(0, 3, 0)
                        break
                    end
                end
            end
        end
    end)
end)

AddButton("วาร์ปไปเก็บปืนที่ตก", function()
    pcall(function()
        local hrp = LocalPlayer.Character and LocalPlayer.Character:FindFirstChild("HumanoidRootPart")
        local gunDrop = workspace:FindFirstChild("GunDrop")
        if hrp and gunDrop and gunDrop:FindFirstChild("Handle") then
            hrp.CFrame = gunDrop.Handle.CFrame + Vector3.new(0, 3, 0)
        end
    end)
end)

local autoCoin = false
AddToggle("Auto Coin Farm (เก็บเหรียญออโต้)", false, function(state) autoCoin = state end)
task.spawn(function()
    while true do
        task.wait(0.4)
        if autoCoin then
            pcall(function()
                local hrp = LocalPlayer.Character and LocalPlayer.Character:FindFirstChild("HumanoidRootPart")
                if hrp then
                    for _, folder in ipairs(workspace:GetChildren()) do
                        if folder.Name:lower():find("coin") or folder.Name == "CoinContainer" then
                            for _, coin in ipairs(folder:GetChildren()) do
                                local part = coin:FindFirstChild("CoinVisual") or coin
                                if part:IsA("BasePart") then
                                    hrp.CFrame = part.CFrame
                                    task.wait(0.1)
                                    break
                                end
                            end
                        end
                    end
                end
            end)
        end
    end
end)

